# Copiar a .env y completar. NUNCA subir el .env al repo.
NODE_ENV=development
PORT=9000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=printflow
DB_SSL=false

# Clave para firmar los JWT. Generar una propia: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Token compartido con n8n para el endpoint de ingesta (Fase 2 · Equipo C)
INGESTA_TOKEN=

# Solo para Docker Compose: puertos en TU PC. Cambiarlos si ya están ocupados
# (p. ej. por un PostgreSQL instalado en Windows o por otro proyecto).
DB_HOST_PORT=5433
WEB_PORT=8080

# Avisos por correo (S3-03). CORREO_MODO: archivo (por defecto: .eml en buzon-salida/), smtp o desactivado.
# En producción, con el SMTP de DOX: CORREO_MODO=smtp y SMTP_*. Para la demo con Mailpit: SMTP_HOST=mailpit, SMTP_PORT=1025.
CORREO_MODO=archivo
CORREO_REMITENTE=PrintFlow <no-responder@printflow.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Enlace que va en los avisos
APP_URL=http://localhost:8080

UMBRAL_SALTO=3

# Solo producción (deploy/docker-compose.prod.yml, ver docs/despliegue.md):
# DOMINIO=printflow-demo.eastus.cloudapp.azure.com
# AZURE_BLOB_SAS_URL=  (opcional) URL del contenedor de Azure Blob Storage con SAS: copia los respaldos fuera de la VM
