      "item": [
        {
          "name": "Lotes pendientes de aprobar (guarda loteId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const filas = pm.response.json().data || [];",
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "if (filas[0]) pm.collectionVariables.set('loteId', String(filas[0].lote_id));",
                  "const conError = filas.find((f) => f.estado_maquina === 'ERROR');",
                  "if (conError) pm.collectionVariables.set('stagingId', String(conError.id_staging_consolidado));",
                  "console.log('Pendientes:', filas.length, '· loteId', filas[0] && filas[0].lote_id, '· en error', conError && conError.id_staging_consolidado);"
                ]
              }
            }
