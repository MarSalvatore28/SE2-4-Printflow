# PrintFlow · proxy de producción (S4-04).
# Caddy obtiene y renueva solo el certificado de Let's Encrypt para {$DOMINIO} y redirige
# HTTP → HTTPS. Con DOMINIO=localhost usa un certificado local (para probar en la PC).
{$DOMINIO} {
	encode gzip

	# Cabeceras de seguridad en TODAS las respuestas (la web, la API, Swagger y Socket.IO).
	# Al quitar cabeceras (-Server) Caddy las aplica al final, sobre lo que responde el nginx: así
	# también se van «Server: nginx» y la de Caddy.
	header {
		# Solo HTTPS durante un año, también en los subdominios
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Nadie puede mostrar PrintFlow dentro de un iframe (clickjacking)
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# La web no usa cámara, micrófono ni ubicación
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Lo mismo que X-Frame-Options, para navegadores modernos. «?»: solo si la respuesta no trae
		# su propia CSP (la API y Swagger traen la suya, más completa, y se respeta)
		?Content-Security-Policy "frame-ancestors 'none'"
		# No anunciar qué servidores hay detrás
		-Server
		-X-Powered-By
	}

	# El nginx del frontend sirve la SPA y reenvía /api, /api-docs y /socket.io a la API
	# (y sigue bloqueando /api/ingesta desde fuera).
	reverse_proxy web:80
}
